# Vorlage für ~/github/private/proton-mail-sorter/.env.pi auf dem Pi.
# provision.sh legt sie an, wenn noch keine da ist. Sie ist git-ignoriert (.env.*).
#
# Was hier steht, gilt zusätzlich zu .env — die Unit liest beide, .env.pi zuletzt.

# Der Name, unter dem das Dashboard erreichbar ist. Muss exakt dem entsprechen, was
# `tailscale serve` ausgibt, sonst lehnt der Origin-Wächter jede Änderung mit 403 und
# SERVER_ORIGIN_REFUSED ab. Ohne abschliessenden Schrägstrich.
PMS_PUBLIC_ORIGIN=https://raspberrypi.dein-tailnet.ts.net

# Das gebaute Dashboard aus demselben Prozess ausliefern. Damit ist alles same-origin und
# tailscale muss nur einen Port kennen. Ohne das serviert `pnpm serve` nur die API, und die
# Seite käme von einem zweiten Port — zwei Origins für ein Postfach.
PMS_WEB_ROOT=/home/pi/github/private/proton-mail-sorter/apps/web/dist

PMS_SERVER_PORT=5174

# Kommt eine SSD dazu, zeigt das hierhin — und ReadWritePaths= in pms.service muss mit.
# PMS_DATA_DIR=/mnt/ssd/pms-data

# Die Anmeldung läuft in einem echten Browser. Auf einem Gerät ohne Bildschirm ist das die
# Reibung: entweder einmal über eine X-Weiterleitung, oder headless über den 1Password-Weg.
# Das Profil bleibt erhalten, damit Proton das Gerät wiedererkennt und weniger nachfragt.
PMS_BROWSER_PROFILE=/home/pi/github/private/proton-mail-sorter/data/browser-profile

# Die Grace-Period ist KEINE Umgebungsvariable — sie steht im Konto-Datensatz und wird im
# Dashboard unter Einstellungen gesetzt (`graceMinutes`, Vorgabe 30). Auf einem Gerät, an dem
# niemand sitzt, liegt der Schlüssel sonst eine halbe Stunde lang im RAM; hier ist 0 die
# ehrlichere Wahl. Daran denken — es ist der eine Knopf, den dieses Skript nicht setzen kann.

LOG_LEVEL=info
