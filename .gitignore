vendor/proton/sieve/dist/


fixtures/

# Screenshots aus dem Testen. Bleiben lokal.
image*.png

*.png

# Except the app's own icons. They are generated by `pnpm icons` and belong in the repository:
# the phone build needs them, and a PNG that only exists on one machine is a broken home screen
# for everybody else.
!apps/web/public/icon-*.png

