{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    // Upstream is authored under looser settings than ours and must stay byte-identical, so the
    // three checks it does not satisfy are relaxed here and here only. Our own code keeps them.
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "noImplicitReturns": false,

    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist/types",
    "rootDir": "."
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "dist"]
}
