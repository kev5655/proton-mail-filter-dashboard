# Copy to .env and adjust. Never commit .env — it is git-ignored.

# 1Password: where the Proton credentials live. Leave PMS_OP_VAULT unset to be
# prompted in the terminal instead. Nothing is read until you approve it in the
# 1Password app.
PMS_OP_VAULT="Kevin Private"
PMS_OP_ITEM="Proton"

# Optional. Add a field with this name to the item above holding a long random
# string, and the whole login becomes a single fingerprint. It encrypts the
# stored session on this machine — a different job from the Proton password, so
# give it its own value rather than reusing the account password.
#
#   op item edit "Proton" --vault "Kevin Private" \
#     "session-passphrase[password]=$(openssl rand -base64 32)"
#
# Without it you are asked to type one, which works just as well.

# trace | debug | info | warn | error
LOG_LEVEL=info
