# Copy to .env and adjust. Never commit .env — it is git-ignored.

# 1Password: where the Proton credentials live. Leave PMS_OP_VAULT unset to be
# prompted in the terminal instead. Nothing is read until you approve it in the
# 1Password app.
PMS_OP_VAULT="Private"
PMS_OP_ITEM="Proton"

# Optional. Only needed when more than one 1Password account is signed in to
# the `op` CLI — otherwise `op` may resolve a different account by default and
# report the item as missing even though the vault name is correct.
PMS_OP_ACCOUNT="my.1password.eu"

# Optional. Add a field with this name to the item above holding a long random
# string, and the whole login becomes a single fingerprint. It encrypts the
# stored session on this machine — a different job from the Proton password, so
# give it its own value rather than reusing the account password.
#
#   op item edit "Proton" --vault "Private" \
#     "session-passphrase[password]=$(openssl rand -base64 32)"
#
# Without it you are asked to type one, which works just as well.

# trace | debug | info | warn | error
LOG_LEVEL=info

# Show the login browser instead of running it hidden. Needed for a passkey: a headless
# browser has no authenticator to touch.
# PMS_BROWSER_HEADLESS=false

# Use a browser installed on this machine instead of the Chromium Playwright downloaded.
# chrome | msedge | chromium. Matters for a passkey, whose credential lives in the real
# browser's own store.
# PMS_BROWSER_CHANNEL=chrome

# Keep the login browser's profile instead of discarding it. Proton then recognises the
# device and asks fewer questions — at the price of cookies sitting in Chrome's own store,
# which this project does not encrypt the way it encrypts the session file. Keep it under
# data/, which is git-ignored, and do not point it at a profile you browse with.
# PMS_BROWSER_PROFILE=data/browser-profile

# Smallest gap between two Proton requests, in milliseconds. Default ~900 plus jitter.
# Lower it only with a reason; the default is deliberately slower than the network allows.
# PMS_MIN_REQUEST_INTERVAL_MS=900
